//@version=6
strategy(
     "XAUUSD Trend + Liquidity Sweep Strategy",
     overlay=true,
     initial_capital=10000,
     currency=currency.USD,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.percent,
     commission_value=0.02,
     slippage=2,
     pyramiding=0)

// Research basis (see chat for sources):
// - Gold's best-documented systematic edge is trend-following on slow
//   moving averages (50/200-style), not fast intraday crossovers.
// - Gold is inversely correlated with the US dollar (DXY) more often
//   than not, so requiring DXY confirmation adds fundamental confluence.
// - Risk 1-2% of equity per trade, sized off ATR, is the standard
//   professional risk-management baseline across futures/CFD trading.
// - Trend-following signals are materially less reliable in choppy,
//   low-volatility, non-trending conditions, hence the ADX and ATR
//   expansion quality filters below.
// This script combines those pieces with an intraday liquidity-sweep +
// engulfing trigger for entry timing, gated to the London and/or New
// York sessions (Asian session removed - thinnest liquidity, weakest
// setups). Recommended chart timeframe: 15m-1H on a gold CFD/futures
// symbol (e.g. OANDA:XAUUSD).

//━━━━━━━━━━━━━━━━━━━
// INPUTS
//━━━━━━━━━━━━━━━━━━━
swingLen         = input.int(5, "Swing Pivot Lookback", group="Entry Trigger")
useLondon        = input.bool(true, "Trade London Session (08:00-17:00)", group="Trading Sessions")
useNY            = input.bool(true, "Trade New York Session (09:30-16:00)", group="Trading Sessions")
useDXY           = input.bool(true, "Require DXY Confirmation", group="Trend Filter")
useADX           = input.bool(true, "Require ADX Trend Strength Filter", group="Quality Filters")
adxLen           = input.int(14, "ADX Length", group="Quality Filters")
adxThreshold     = input.float(20, "Minimum ADX", group="Quality Filters")
useVolFilter     = input.bool(true, "Require Expanding Volatility (ATR > ATR Average)", group="Quality Filters")
atrSmaLen        = input.int(50, "ATR Average Length", group="Quality Filters")
riskPct          = input.float(1.0, "Risk per Trade (%)", minval=0.1, maxval=5.0, group="Risk Management")
atrLen           = input.int(14, "ATR Length", group="Risk Management")
slMult           = input.float(2.0, "Stop Loss (x ATR)", group="Risk Management")
rr               = input.float(2.0, "Reward:Risk Multiple", group="Risk Management")
useBreakeven     = input.bool(true, "Move Stop to Breakeven After 1R Profit", group="Trade Management")
useSeasonFilter  = input.bool(false, "Avoid Seasonally Weak Months (Feb/Mar/Jun/Oct)", group="Seasonality")
startTime        = input.time(timestamp("2018-01-01"), "Backtest Start", group="Backtest Window")
endTime          = input.time(timestamp("2099-01-01"), "Backtest End", group="Backtest Window")
guaranteeWeekly  = input.bool(true, "Guarantee Minimum Trades Per Week", group="Trade Frequency")
minTradesPerWeek = input.int(4, "Minimum Trades Per Week", minval=1, maxval=10, group="Trade Frequency")
fallbackHour     = input.int(15, "Pace-Check Hour (NY Time, 24h)", minval=0, maxval=23, group="Trade Frequency")

inDateRange = time >= startTime and time <= endTime

//━━━━━━━━━━━━━━━━━━━
// HIGHER-TIMEFRAME TREND (Daily EMA50/200 structure)
//━━━━━━━━━━━━━━━━━━━
dEmaFast = request.security(syminfo.tickerid, "D", ta.ema(close, 50), lookahead=barmerge.lookahead_off)
dEmaSlow = request.security(syminfo.tickerid, "D", ta.ema(close, 200), lookahead=barmerge.lookahead_off)

bullBias = close > dEmaFast and dEmaFast > dEmaSlow
bearBias = close < dEmaFast and dEmaFast < dEmaSlow

//━━━━━━━━━━━━━━━━━━━
// DXY CONFIRMATION (inverse correlation confluence)
//━━━━━━━━━━━━━━━━━━━
dxyEmaFast = request.security("TVC:DXY", "D", ta.ema(close, 50), lookahead=barmerge.lookahead_off)
dxyEmaSlow = request.security("TVC:DXY", "D", ta.ema(close, 200), lookahead=barmerge.lookahead_off)

dxyDowntrend = dxyEmaFast < dxyEmaSlow
dxyUptrend   = dxyEmaFast > dxyEmaSlow

dxyLongOK  = useDXY ? dxyDowntrend : true
dxyShortOK = useDXY ? dxyUptrend   : true

//━━━━━━━━━━━━━━━━━━━
// QUALITY FILTERS (skip choppy, non-trending, low-volatility conditions)
//━━━━━━━━━━━━━━━━━━━
atrVal = ta.atr(atrLen)
volOK  = useVolFilter ? atrVal > ta.sma(atrVal, atrSmaLen) : true

[_, _, adxVal] = ta.dmi(adxLen, adxLen)
adxOK = useADX ? adxVal >= adxThreshold : true

//━━━━━━━━━━━━━━━━━━━
// SEASONALITY FILTER (optional conviction filter, not a hard requirement)
//━━━━━━━━━━━━━━━━━━━
weakMonth = month(time) == 2 or month(time) == 3 or month(time) == 6 or month(time) == 10
seasonOK  = useSeasonFilter ? not weakMonth : true

//━━━━━━━━━━━━━━━━━━━
// TRADING SESSIONS (London and New York; each in its own local
// exchange timezone so DST shifts don't drift the window)
//━━━━━━━━━━━━━━━━━━━
londonTime = time(timeframe.period, "0800-1700", "Europe/London")
nyTime     = time(timeframe.period, "0930-1600", "America/New_York")

inLondon = not na(londonTime)
inNY     = not na(nyTime)

anySessionEnabled = useLondon or useNY
sessionOK = anySessionEnabled ? ((useLondon and inLondon) or (useNY and inNY)) : true

//━━━━━━━━━━━━━━━━━━━
// LIQUIDITY SWEEP (of last confirmed swing pivot)
//━━━━━━━━━━━━━━━━━━━
pivotLow  = ta.pivotlow(swingLen, swingLen)
pivotHigh = ta.pivothigh(swingLen, swingLen)

var float lastSwingLow  = na
var float lastSwingHigh = na

if not na(pivotLow)
    lastSwingLow := pivotLow
if not na(pivotHigh)
    lastSwingHigh := pivotHigh

sellSideSweep = not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow
buySideSweep  = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh

//━━━━━━━━━━━━━━━━━━━
// ENGULFING CONFIRMATION
//━━━━━━━━━━━━━━━━━━━
bullishEngulf = close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
bearishEngulf = close < open and close[1] > open[1] and open >= close[1] and close <= open[1]

//━━━━━━━━━━━━━━━━━━━
// PRIMARY SIGNAL (A+ setup)
//━━━━━━━━━━━━━━━━━━━
buySignal  = bullBias and dxyLongOK  and adxOK and volOK and seasonOK and sessionOK and sellSideSweep and bullishEngulf and inDateRange
sellSignal = bearBias and dxyShortOK and adxOK and volOK and seasonOK and sessionOK and buySideSweep  and bearishEngulf and inDateRange

//━━━━━━━━━━━━━━━━━━━
// WEEKLY TRADE FREQUENCY GUARANTEE
// Paces toward a minimum trade count per week instead of forcing a
// trade every single day: checks progress at a fixed hour each
// weekday and only forces a trade if behind the weekly pace. Forced
// trades skip the ADX/volatility/DXY quality filters (by design -
// that's the trade-off for guaranteeing frequency) but keep identical
// risk sizing and stop/target management to primary trades.
//━━━━━━━━━━━━━━━━━━━
dow  = dayofweek(time, "America/New_York")
pdow = dayofweek(time[1], "America/New_York")
newWeek = dow == dayofweek.monday and pdow != dayofweek.monday

var int tradesThisWeek = 0
if newWeek
    tradesThisWeek := 0

requiredByNow = switch
    dow == dayofweek.monday    => int(math.ceil(minTradesPerWeek * 1.0 / 4.0))
    dow == dayofweek.tuesday   => int(math.ceil(minTradesPerWeek * 2.0 / 4.0))
    dow == dayofweek.wednesday => int(math.ceil(minTradesPerWeek * 3.0 / 4.0))
    dow == dayofweek.thursday or dow == dayofweek.friday => minTradesPerWeek
    => 0

nyHour         = hour(time, "America/New_York")
fallbackWindow = nyHour >= fallbackHour and sessionOK and tradesThisWeek < requiredByNow

fallbackLong  = guaranteeWeekly and fallbackWindow and bullBias and inDateRange
fallbackShort = guaranteeWeekly and fallbackWindow and bearBias and inDateRange

finalBuySignal  = buySignal or fallbackLong
finalSellSignal = sellSignal or fallbackShort

//━━━━━━━━━━━━━━━━━━━
// RISK-BASED POSITION SIZING + BRACKET EXITS
//━━━━━━━━━━━━━━━━━━━
var float longStop       = na
var float longTarget     = na
var float longEntryPrice = na
var float longInitRisk   = na

var float shortStop       = na
var float shortTarget     = na
var float shortEntryPrice = na
var float shortInitRisk   = na

canEnter   = strategy.position_size == 0 and not na(atrVal) and atrVal > 0
enterLong  = finalBuySignal and canEnter
enterShort = finalSellSignal and canEnter

if enterLong
    stopDist       = atrVal * slMult
    riskAmount     = strategy.equity * (riskPct / 100)
    qty            = riskAmount / stopDist
    longEntryPrice := close
    longInitRisk   := stopDist
    longStop       := close - stopDist
    longTarget     := close + stopDist * rr
    strategy.entry("Long", strategy.long, qty=qty)
    tradesThisWeek := tradesThisWeek + 1

if enterShort
    stopDist        = atrVal * slMult
    riskAmount      = strategy.equity * (riskPct / 100)
    qty             = riskAmount / stopDist
    shortEntryPrice := close
    shortInitRisk   := stopDist
    shortStop       := close + stopDist
    shortTarget     := close - stopDist * rr
    strategy.entry("Short", strategy.short, qty=qty)
    tradesThisWeek  := tradesThisWeek + 1

// Breakeven stop management: once a trade reaches 1R in profit, ratchet
// the stop to entry price so a reversal can no longer turn a winner
// into a loser. This trades a small amount of "stopped at breakeven"
// noise for a meaningfully lower average loss.
if useBreakeven and strategy.position_size > 0 and not na(longEntryPrice) and not na(longInitRisk)
    if high >= longEntryPrice + longInitRisk
        longStop := math.max(longStop, longEntryPrice)

if useBreakeven and strategy.position_size < 0 and not na(shortEntryPrice) and not na(shortInitRisk)
    if low <= shortEntryPrice - shortInitRisk
        shortStop := math.min(shortStop, shortEntryPrice)

strategy.exit("Long Exit", from_entry="Long", stop=longStop, limit=longTarget)
strategy.exit("Short Exit", from_entry="Short", stop=shortStop, limit=shortTarget)

//━━━━━━━━━━━━━━━━━━━
// VISUALS
//━━━━━━━━━━━━━━━━━━━
plot(dEmaFast, "Daily EMA50", color=color.new(color.orange, 0), linewidth=2)
plot(dEmaSlow, "Daily EMA200", color=color.new(color.purple, 0), linewidth=2)

plotshape(enterLong and buySignal ? close : na, style=shape.triangleup, location=location.belowbar, color=color.blue, size=size.small, title="Buy (A+ Setup)")
plotshape(enterShort and sellSignal ? close : na, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Sell (A+ Setup)")
plotshape(enterLong and not buySignal ? close : na, style=shape.diamond, location=location.belowbar, color=color.aqua, size=size.small, title="Buy (Weekly Quota Trade)")
plotshape(enterShort and not sellSignal ? close : na, style=shape.diamond, location=location.abovebar, color=color.orange, size=size.small, title="Sell (Weekly Quota Trade)")

//━━━━━━━━━━━━━━━━━━━
// ALERTS
//━━━━━━━━━━━━━━━━━━━
alertcondition(finalBuySignal, title="XAUUSD Strategy Buy", message="XAUUSD Strategy: BUY signal")
alertcondition(finalSellSignal, title="XAUUSD Strategy Sell", message="XAUUSD Strategy: SELL signal")
