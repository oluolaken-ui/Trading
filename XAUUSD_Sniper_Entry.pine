//@version=6
indicator("XAUUSD Sniper Entry (Dot Only)", overlay=true)

//━━━━━━━━━━━━━━━━━━━
// INPUTS
//━━━━━━━━━━━━━━━━━━━
swingLen = input.int(5, "Swing Pivot Lookback")
useNY    = input.bool(true, "NY Session Only")

//━━━━━━━━━━━━━━━━━━━
// DAILY BIAS (vs. prior completed day's close)
//━━━━━━━━━━━━━━━━━━━
dailyClose = request.security(syminfo.tickerid, "D", close[1])
bullBias   = close > dailyClose
bearBias   = close < dailyClose

//━━━━━━━━━━━━━━━━━━━
// NY SESSION (09:30–16:00 America/New_York, DST-aware)
//━━━━━━━━━━━━━━━━━━━
nyTime    = time(timeframe.period, "0930-1600", "America/New_York")
sessionOK = useNY ? not na(nyTime) : true

//━━━━━━━━━━━━━━━━━━━
// LIQUIDITY SWEEP (of last confirmed swing pivot)
//━━━━━━━━━━━━━━━━━━━
pivotLow  = ta.pivotlow(swingLen, swingLen)
pivotHigh = ta.pivothigh(swingLen, swingLen)

var float lastSwingLow  = na
var float lastSwingHigh = na

if not na(pivotLow)
    lastSwingLow := pivotLow
if not na(pivotHigh)
    lastSwingHigh := pivotHigh

sellSideSweep = not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow
buySideSweep  = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh

//━━━━━━━━━━━━━━━━━━━
// ENGULFING CONFIRMATION
//━━━━━━━━━━━━━━━━━━━
bullishEngulf = close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
bearishEngulf = close < open and close[1] > open[1] and open >= close[1] and close <= open[1]

//━━━━━━━━━━━━━━━━━━━
// FINAL SIGNAL
//━━━━━━━━━━━━━━━━━━━
buySignal  = bullBias and sessionOK and sellSideSweep and bullishEngulf
sellSignal = bearBias and sessionOK and buySideSweep and bearishEngulf

//━━━━━━━━━━━━━━━━━━━
// EXACT ENTRY DOTS
//━━━━━━━━━━━━━━━━━━━
plotshape(
    buySignal ? close : na,
    style=shape.circle,
    location=location.absolute,
    color=color.blue,
    size=size.small
)

plotshape(
    sellSignal ? close : na,
    style=shape.circle,
    location=location.absolute,
    color=color.red,
    size=size.small
)
